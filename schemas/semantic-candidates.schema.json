{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/draftledger/semantic-candidates.schema.json",
  "title": "DraftLedger Semantic Retrieval Candidates",
  "type": "object",
  "required": [
    "version",
    "producer",
    "method",
    "candidates"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "enum": [
        "embedding",
        "model",
        "hybrid",
        "external"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "score"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[FAIDO]-[0-9]{3,}$"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
